<?php
/**
 * GEO SEO City Landing Page
 * Dynamic page for /peptidos-en-{city}/ and /peptidos-en-{city}/{product}/
 */

$city_slug = get_query_var('sp_geo_city');
$product_slug = get_query_var('sp_geo_product');
$cities = sp_geo_cities();

if (!$city_slug || !isset($cities[$city_slug])) {
    wp_redirect(home_url('/'));
    exit;
}

$city = $cities[$city_slug];
$city_name = $city['name'];
$dept = $city['dept'];

// Resolve product if specified
$product_obj = null;
$wc_product = null;
$is_product_page = false;

if ($product_slug) {
    // Query product by slug
    $args = array(
        'name'        => $product_slug,
        'post_type'   => 'product',
        'post_status' => 'publish',
        'numberposts' => 1
    );
    $posts = get_posts($args);
    if (!empty($posts)) {
        $product_obj = $posts[0];
        $wc_product = wc_get_product($product_obj->ID);
        $is_product_page = true;
    }
}

get_header();

// Title and description generation based on context
if ($is_product_page && $wc_product) {
    $page_title = esc_html($wc_product->get_name()) . ' en ' . esc_html($city_name);
    $hero_h1 = esc_html($wc_product->get_name()) . ' en <span>' . esc_html($city_name) . '</span>';
    $hero_desc = 'Adquiere ' . esc_html($wc_product->get_name()) . ' de ultra-alta pureza directamente en ' . esc_html($city_name) . ', ' . esc_html($dept) . '. Cada lote cuenta con análisis de laboratorio HPLC superior al 98% de pureza. Despacho térmico urgente gratuito para preservar la cadena de frío.';
} else {
    $page_title = 'Péptidos de Investigación en ' . esc_html($city_name);
    $hero_h1 = 'Péptidos de Investigación en <span>' . esc_html($city_name) . '</span>';
    $hero_desc = 'Distribuimos péptidos de ultra-alta pureza directamente a ' . esc_html($city_name) . ', ' . esc_html($dept) . '. Cada vial cuenta con certificación HPLC de pureza y espectrometría de masas. Envío gratis con entrega en 2-5 días hábiles a toda la zona metropolitana.';
}
