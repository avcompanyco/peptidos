<!-- HELPERS & PHP RENDERING -->
<?php
function sp_render_peptide_card($product_id, $clinical_desc, $badge = '') {
    $product = wc_get_product($product_id);
    if (!$product) return;
    
    $name = $product->get_name();
    $price = $product->get_price_html();
    $url = $product->get_permalink();
    $image = $product->get_image('thumbnail');
    ?>
    <div class="peptide-card" onclick="window.location.href='<?php echo esc_url($url); ?>'">
        <div class="peptide-card-header">
            <div class="peptide-image-box">
                <?php echo $image; ?>
            </div>
            <?php if ($badge) : ?>
                <span class="peptide-badge"><?php echo esc_html($badge); ?></span>
            <?php endif; ?>
        </div>
        <div class="peptide-name"><?php echo esc_html($name); ?></div>
        <div class="peptide-desc"><?php echo esc_html($clinical_desc); ?></div>
        <div class="peptide-price-row">
            <span class="peptide-price"><?php echo $price; ?></span>
            <button class="peptide-add-btn sp-add-to-cart" data-product-id="<?php echo $product_id; ?>" onclick="event.stopPropagation();">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
        </div>
    </div>
    <?php
}
?>

