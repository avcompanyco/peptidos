}

.ticker {
    display: flex;
    white-space: nowrap;
    animation: marquee 35s linear infinite;
    width: max-content;
}

.ticker-item {
    font-size: 0.7rem;
    font-weight: 700;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 0.18em;
