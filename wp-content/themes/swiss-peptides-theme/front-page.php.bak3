    align-items: center;
    gap: 8px;
}

.ticker-item svg {
    color: var(--accent);
    width: 12px;
    height: 12px;
}

@keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}

/* --- PEPTIDE CARD STYLE --- */
.peptide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    margin-top: 20px;
}

.peptide-card {
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    transition: all 0.35s var(--ease-out);
    cursor: pointer;
    position: relative;
    display: flex;
    flex-direction: column;
}

.peptide-card:hover {
    border-color: var(--accent);
    box-shadow: 0 10px 30px rgba(14, 165, 233, 0.15);
    transform: translateY(-4px);
    background: rgba(15, 23, 42, 0.6);
}

.peptide-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-md);
}

.peptide-image-box {
    width: 72px;
    height: 72px;
    background: #ffffff;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    border: 1px solid rgba(255,255,255,0.08);
}

.peptide-image-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
}

.peptide-badge {
    padding: 4px 10px;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--accent);
    color: #ffffff;
    border-radius: var(--radius-full);
}

.peptide-name {
    font-family: var(--font-heading);
    font-size: var(--fs-md);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 8px;
}

.peptide-desc {
    font-size: var(--fs-sm);
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
    min-height: 64px;
}

.peptide-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
}

.peptide-price {
    font-family: var(--font-heading);
    font-size: var(--fs-md);
    font-weight: 700;
    color: #ffffff;
}

.peptide-add-btn {
    width: 38px;
    height: 38px;
    background: rgba(255,255,255,0.08);
    color: #ffffff;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    border: 1px solid rgba(255,255,255,0.1);
}

.peptide-card:hover .peptide-add-btn {
    background: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
}

/* --- TABS SYSTEM --- */
.tabs-nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 40px;
    flex-wrap: wrap;
}

.tab-btn {
    padding: 12px 28px;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.8);
    transition: all 0.3s ease;
}

.tab-btn:hover, .tab-btn.active {
    background: #ffffff;
    color: var(--navy);
    border-color: #ffffff;
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.15);
}

.tab-content {
    display: none;
}

.tab-content.active {
    display: block;
    animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
}

/* --- WEIGHT LOSS FOCUS --- */
.wl-card-featured {
    background: linear-gradient(135deg, rgba(15,23,42,0.6) 0%, rgba(30,41,59,0.6) 100%);
    border: 1.5px solid rgba(14, 165, 233, 0.25);
}

/* --- LOGISTICS & DISCOUNTS --- */
.logistics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: stretch;
}

.logistics-card {
    background: rgba(15, 23, 42, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
}

.discount-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}

.discount-row:last-child {
    border-bottom: none;
}

.discount-qty {
    font-weight: 700;
    font-size: var(--fs-sm);
    color: #ffffff;
}

.discount-val {
    font-weight: 800;
    color: var(--accent);
}

.discount-row.recommended {
    background: rgba(14, 165, 233, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    border: 1px solid rgba(14, 165, 233, 0.2);
}

/* --- RESPONSIVE ADJUSTMENTS --- */
@media(max-width: 1024px) {
    .peptide-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .logistics-grid {
        grid-template-columns: 1fr;
    }
}

@media(max-width: 640px) {
    .peptide-grid {
        grid-template-columns: 1fr;
    }
    .hero-card {
        padding: var(--space-xl);
    }
    .hero-features {
        gap: var(--space-md);
    }
}
