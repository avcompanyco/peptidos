/* ============================================
   SWISS PEPTIDES COLOMBIA — DESIGN SYSTEM v2.0
   Clinical Luxury White Theme 2026
   ============================================ */

/* --- Google Fonts --- */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap');

/* --- CSS Custom Properties --- */
:root {
  /* Palette: Clinical White + Navy + Teal */
  --white: #FFFFFF;
  --off-white: #FAFBFC;
  --gray-50: #F8F9FA;
  --gray-100: #F1F3F5;
  --gray-200: #E9ECEF;
  --gray-300: #DEE2E6;
  --gray-400: #CED4DA;
  --gray-500: #ADB5BD;
  --gray-600: #868E96;
  --gray-700: #495057;
  --gray-800: #343A40;
  --gray-900: #212529;
  --navy: #0B1D3A;
  --navy-light: #1A3A5C;
  --teal: #0EA5E9;
  --teal-dark: #0284C7;
  --teal-light: #E0F2FE;
  --emerald: #10B981;
  --red: #EF4444;
  --amber: #F59E0B;

  /* Semantic tokens */
  --bg-primary: var(--white);
  --bg-secondary: var(--gray-50);
  --bg-tertiary: var(--gray-100);
  --text-primary: var(--navy);
  --text-secondary: var(--gray-700);
  --text-muted: var(--gray-500);
  --text-accent: var(--teal-dark);
  --border-color: var(--gray-200);
  --border-subtle: var(--gray-100);
  --accent: var(--teal);
  --accent-dark: var(--teal-dark);
  --success: var(--emerald);
  --error: var(--red);
  --warning: var(--amber);

  /* Shadows — soft and elevated */
  --shadow-xs: 0 1px 2px rgba(0,0,0,0.04);
  --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
  --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.06), 0 2px 4px -2px rgba(0,0,0,0.04);
  --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.06), 0 4px 6px -4px rgba(0,0,0,0.04);
  --shadow-xl: 0 20px 25px -5px rgba(0,0,0,0.06), 0 8px 10px -6px rgba(0,0,0,0.04);
  --shadow-card: 0 0 0 1px var(--border-color), 0 1px 3px rgba(0,0,0,0.04);
  --shadow-hover: 0 0 0 1px var(--accent), 0 8px 25px -5px rgba(14,165,233,0.12);

  /* Typography */
  --font-primary: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-heading: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
  --fs-xs: 0.75rem;
  --fs-sm: 0.875rem;
  --fs-base: 1rem;
  --fs-md: 1.125rem;
  --fs-lg: 1.25rem;
  --fs-xl: 1.5rem;
  --fs-2xl: 2rem;
  --fs-3xl: 2.5rem;
  --fs-4xl: 3.25rem;
  --fs-5xl: 4rem;
  --lh-tight: 1.15;
  --lh-snug: 1.3;
  --lh-normal: 1.6;
  --lh-relaxed: 1.8;

  /* Spacing */
  --space-2xs: 0.25rem;
  --space-xs: 0.5rem;
  --space-sm: 0.75rem;
  --space-md: 1rem;
  --space-lg: 1.5rem;
  --space-xl: 2rem;
  --space-2xl: 3rem;
  --space-3xl: 4rem;
  --space-4xl: 6rem;
  --space-5xl: 8rem;

  /* Radius */
  --radius-sm: 6px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 16px;
  --radius-2xl: 20px;
  --radius-full: 9999px;

  /* Layout */
  --max-width: 1280px;
  --navbar-height: 72px;

  /* Z-index */
  --z-base: 1;
  --z-dropdown: 100;
  --z-sticky: 200;
  --z-overlay: 500;
  --z-modal: 600;
  --z-toast: 700;
  --z-max: 999;

  /* Transitions */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --transition-fast: 150ms var(--ease-out);
  --transition-base: 250ms var(--ease-out);
  --transition-slow: 400ms var(--ease-out);
}

/* --- Reset --- */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}
body {
  font-family: var(--font-primary);
  font-size: var(--fs-base);
  line-height: var(--lh-normal);
  color: var(--text-primary);
  background: var(--bg-primary);
  overflow-x: hidden;
}
img { max-width: 100%; height: auto; display: block; }
a { text-decoration: none; color: inherit; transition: color var(--transition-fast); }
button { cursor: pointer; border: none; background: none; font-family: inherit; }
ul, ol { list-style: none; }
input, select, textarea { font-family: inherit; font-size: inherit; }
::selection { background: var(--teal-light); color: var(--navy); }

/* --- Container --- */
.container { width: 100%; max-width: var(--max-width); margin: 0 auto; padding: 0 clamp(1rem, 3vw, 2rem); }

/* --- Section --- */
.section { padding: var(--space-5xl) 0; }
.section--gray { background: var(--bg-secondary); }
.section--navy { background: var(--navy); color: var(--white); }

/* --- Typography --- */
h1, h2, h3, h4, h5, h6 { font-family: var(--font-heading); font-weight: 700; line-height: var(--lh-tight); color: var(--text-primary); letter-spacing: -0.02em; }
.section--navy h1, .section--navy h2, .section--navy h3, .section--navy h4 { color: var(--white); }
.section-label {
  display: inline-flex; align-items: center; gap: var(--space-xs);
  font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.12em; color: var(--accent); margin-bottom: var(--space-md);
}
.section-label::before { content: ''; width: 24px; height: 1.5px; background: var(--accent); display: inline-block; }
.section-title { font-size: clamp(var(--fs-2xl), 4vw, var(--fs-4xl)); margin-bottom: var(--space-md); }
.section-subtitle { font-size: var(--fs-md); color: var(--text-secondary); max-width: 560px; line-height: var(--lh-relaxed); }
.text-center { text-align: center; }
.text-center .section-label { justify-content: center; }
.text-center .section-subtitle { margin-left: auto; margin-right: auto; }
.text-accent { color: var(--accent); }
.text-gradient { background: linear-gradient(135deg, var(--teal), var(--teal-dark)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }

/* --- Top Bar --- */
.top-bar {
  background: var(--navy); color: var(--white);
  padding: 10px 0; font-size: var(--fs-xs);
  text-align: center; letter-spacing: 0.04em;
  position: relative; z-index: 1001;
}
.top-bar-content {
  display: flex; align-items: center; justify-content: center;
  gap: var(--space-3xl); flex-wrap: wrap;
}
.top-bar-item { display: flex; align-items: center; gap: var(--space-sm); opacity: 0.9; }
.top-bar-item svg { width: 15px; height: 15px; opacity: 0.8; }

/* --- Navbar --- */
.navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: var(--z-sticky);
  background: rgba(255,255,255,0.92); backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1px solid var(--border-subtle);
  transition: top 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  height: var(--navbar-height);
}
.navbar.scrolled { box-shadow: var(--shadow-md); border-bottom-color: var(--border-color); top: 0; }
.navbar .container {
  display: flex; align-items: center; justify-content: space-between;
  height: 100%;
}
.nav-logo { display: flex; align-items: center; gap: var(--space-sm); }
.nav-logo img { height: 26px; width: auto; object-fit: contain; }
.navbar .nav-logo img { filter: brightness(0); }
.preloader-logo { filter: brightness(0) !important; }
.nav-logo-text { display: none; }
.nav-links { display: flex; align-items: center; gap: var(--space-2xl); }
.nav-link {
  font-size: var(--fs-sm); font-weight: 500; color: var(--text-secondary);
  transition: color var(--transition-fast); position: relative; padding: var(--space-xs) 0;
}
.nav-link:hover, .nav-link.active { color: var(--navy); }
.nav-link.active::after {
  content: ''; position: absolute; bottom: -2px; left: 0; right: 0;
  height: 2px; background: var(--accent); border-radius: var(--radius-full);
}
.nav-actions { display: flex; align-items: center; gap: var(--space-md); }
.nav-action-btn {
  width: 40px; height: 40px; border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  color: var(--text-secondary); transition: all var(--transition-fast);
  position: relative;
}
.nav-action-btn:hover { background: var(--gray-100); color: var(--navy); }
.nav-action-btn svg { width: 20px; height: 20px; }
.cart-count {
  position: absolute; top: 2px; right: 2px;
  width: 18px; height: 18px; border-radius: 50%;
  background: var(--accent); color: var(--white);
  font-size: 0.6rem; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.nav-hamburger {
  display: none; flex-direction: column; gap: 5px; cursor: pointer;
  padding: var(--space-xs);
}
.nav-hamburger span {
  width: 22px; height: 1.5px; background: var(--navy);
  transition: all var(--transition-fast);
}
.mobile-menu {
  display: none; position: fixed; top: var(--navbar-height); left: 0; right: 0;
  background: var(--white); z-index: var(--z-overlay);
  padding: var(--space-xl); flex-direction: column; gap: var(--space-md);
  box-shadow: var(--shadow-xl); border-bottom: 1px solid var(--border-color);
}
.mobile-menu.active { display: flex; }

/* --- Buttons --- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: var(--space-xs);
  font-family: var(--font-heading); font-weight: 600; font-size: var(--fs-sm);
  letter-spacing: 0.02em; border-radius: var(--radius-md);
  padding: 12px 28px; transition: all var(--transition-fast);
  white-space: nowrap; cursor: pointer; border: none; outline: none;
}
.btn svg { width: 16px; height: 16px; }
.btn-primary {
  background: var(--navy); color: var(--white);
  box-shadow: 0 1px 2px rgba(11,29,58,0.2);
}
.btn-primary:hover {
  background: var(--navy-light);
  box-shadow: 0 4px 12px rgba(11,29,58,0.25);
  transform: translateY(-1px);
}
.btn-accent {
  background: var(--accent); color: var(--white);
  box-shadow: 0 1px 2px rgba(14,165,233,0.3);
}
.btn-accent:hover {
  background: var(--accent-dark);
  box-shadow: 0 4px 12px rgba(14,165,233,0.3);
  transform: translateY(-1px);
}
.btn-outline {
  background: transparent; color: var(--navy);
  border: 1.5px solid var(--border-color);
}
.btn-outline:hover { border-color: var(--navy); background: var(--gray-50); }
.btn-ghost { background: transparent; color: var(--text-secondary); }
.btn-ghost:hover { color: var(--navy); background: var(--gray-50); }
.btn-lg { padding: 16px 36px; font-size: var(--fs-base); border-radius: var(--radius-lg); }
.btn-sm { padding: 8px 18px; font-size: var(--fs-xs); }

/* --- Badge --- */
.badge {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 4px 10px; font-size: 0.65rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.08em;
  border-radius: var(--radius-full);
  background: var(--teal-light); color: var(--teal-dark);
  border: 1px solid rgba(14,165,233,0.15);
}
.badge-success { background: rgba(16,185,129,0.08); color: var(--success); border-color: rgba(16,185,129,0.15); }
.badge-warning { background: rgba(245,158,11,0.08); color: var(--warning); border-color: rgba(245,158,11,0.15); }
.badge-navy { background: rgba(11,29,58,0.06); color: var(--navy); border-color: rgba(11,29,58,0.1); }

/* --- Product Cards --- */
.product-card {
  background: var(--white); border: 1px solid var(--border-color);
  border-radius: var(--radius-xl); overflow: hidden;
  transition: all var(--transition-slow); cursor: pointer;
}
.product-card:hover {
  box-shadow: var(--shadow-hover);
  border-color: rgba(14,165,233,0.3);
  transform: translateY(-3px);
}
.product-image-wrap {
  aspect-ratio: 1; background: #ffffff;
  overflow: hidden; position: relative; padding: var(--space-lg);
  display: flex; align-items: center; justify-content: center;
}
.product-image-wrap img {
  max-width: 85%; max-height: 85%; object-fit: contain;
  transition: transform 0.5s var(--ease-out);
}
.product-card:hover .product-image-wrap img { transform: scale(1.06); }
.product-badge {
  position: absolute; top: var(--space-md); left: var(--space-md);
  padding: 4px 10px; font-size: 0.6rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.1em;
  background: var(--navy); color: var(--white); border-radius: var(--radius-full);
}
.product-card .product-actions {
  position: absolute; right: var(--space-md); top: var(--space-md);
  display: flex; flex-direction: column; gap: var(--space-xs);
  opacity: 0; transform: translateX(8px);
  transition: all var(--transition-base);
}
.product-card:hover .product-actions { opacity: 1; transform: none; }
.product-action-btn {
  width: 36px; height: 36px; border-radius: var(--radius-md);
  background: var(--white); border: 1px solid var(--border-color);
  display: flex; align-items: center; justify-content: center;
  color: var(--text-secondary); box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast);
}
.product-action-btn:hover { background: var(--navy); color: var(--white); border-color: var(--navy); }
.product-info { padding: var(--space-lg); }
.product-category {
  font-size: 0.65rem; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.1em; color: var(--accent); margin-bottom: var(--space-xs);
}
.product-rating { display: flex; align-items: center; gap: 4px; margin-bottom: var(--space-xs); }
.product-rating .star { color: var(--amber); font-size: var(--fs-xs); }
.product-rating .reviews-count { font-size: 0.65rem; color: var(--text-muted); }
.product-name {
  font-family: var(--font-heading); font-size: var(--fs-base);
  font-weight: 700; margin-bottom: 2px; line-height: var(--lh-snug);
  color: var(--navy);
}
.product-subtitle { font-size: var(--fs-xs); color: var(--text-muted); margin-bottom: var(--space-sm); }
.product-price-row { display: flex; align-items: center; justify-content: space-between; }
.product-price {
  font-family: var(--font-heading); font-size: var(--fs-lg);
  font-weight: 700; color: var(--navy);
}
.product-price-original { font-size: var(--fs-xs); color: var(--text-muted); text-decoration: line-through; margin-left: var(--space-xs); }
.product-add-btn {
  width: 36px; height: 36px; border-radius: var(--radius-md);
  background: var(--navy); color: var(--white);
  display: flex; align-items: center; justify-content: center;
  transition: all var(--transition-fast); flex-shrink: 0;
}
.product-add-btn:hover { background: var(--accent); transform: scale(1.05); }

/* --- Forms --- */
.form-group { margin-bottom: var(--space-lg); }
.form-label { display: block; font-size: var(--fs-sm); font-weight: 500; color: var(--text-secondary); margin-bottom: var(--space-xs); }
.form-input, .form-select {
  width: 100%; padding: 12px 16px; font-size: var(--fs-sm);
  background: var(--white); border: 1.5px solid var(--border-color);
  border-radius: var(--radius-md); color: var(--text-primary);
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  outline: none;
}
.form-input:focus, .form-select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(14,165,233,0.1);
}
.form-input::placeholder { color: var(--text-muted); }

/* --- Tag (filter chips) --- */
.tag {
  display: inline-flex; align-items: center; gap: var(--space-xs);
  padding: 8px 16px; font-size: var(--fs-xs); font-weight: 500;
  border: 1.5px solid var(--border-color); border-radius: var(--radius-full);
  cursor: pointer; transition: all var(--transition-fast);
  background: var(--white); color: var(--text-secondary);
}
.tag:hover { border-color: var(--navy); color: var(--navy); }
.tag.active { background: var(--navy); color: var(--white); border-color: var(--navy); }

/* --- Cart Sidebar --- */
.cart-sidebar {
  position: fixed; right: 0; top: 0; bottom: 0; width: 420px; max-width: 90vw;
  background: var(--white); z-index: var(--z-modal);
  transform: translateX(100%); transition: transform var(--transition-slow);
  display: flex; flex-direction: column;
  box-shadow: -10px 0 40px rgba(0,0,0,0.08);
  border-left: 1px solid var(--border-color);
}
.cart-sidebar.active, .cart-sidebar.open { transform: translateX(0); }
.cart-sidebar-header {
  padding: var(--space-xl) var(--space-xl) var(--space-lg); display: flex; align-items: center;
  justify-content: space-between; border-bottom: 1px solid var(--border-color);
}
.cart-sidebar-header h3 { font-family: var(--font-heading); font-size: var(--fs-lg); }
.cart-sidebar-body { flex: 1; overflow-y: auto; padding: var(--space-lg); }
.cart-sidebar-footer { padding: var(--space-xl); border-top: 1px solid var(--border-color); }

/* --- Overlay --- */
.overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.25);
  backdrop-filter: blur(4px); z-index: var(--z-overlay);
  opacity: 0; visibility: hidden; transition: all var(--transition-base);
}
.overlay.active { opacity: 1; visibility: visible; }

/* --- Footer --- */
.footer {
  background: var(--navy); color: rgba(255,255,255,0.7);
  padding: var(--space-4xl) 0 var(--space-xl);
}
.footer-grid {
  display: grid; grid-template-columns: 1.5fr repeat(3, 1fr);
  gap: var(--space-3xl); margin-bottom: var(--space-3xl);
}
.footer-brand p { font-size: var(--fs-sm); line-height: var(--lh-relaxed); margin-top: var(--space-md); }
.footer-title {
  font-family: var(--font-heading); font-size: var(--fs-xs); font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--white); margin-bottom: var(--space-lg);
}
.footer-links { display: flex; flex-direction: column; gap: var(--space-sm); }
.footer-links a { font-size: var(--fs-sm); transition: color var(--transition-fast); }
.footer-links a:hover { color: var(--white); }
.footer-bottom {
  display: flex; justify-content: space-between; align-items: center;
  padding-top: var(--space-xl); border-top: 1px solid rgba(255,255,255,0.08);
  font-size: var(--fs-xs); opacity: 0.5;
}

/* --- Free Shipping Bar --- */
.shipping-bar { background: var(--gray-50); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: var(--space-md) var(--space-lg); }
.shipping-bar-text { font-size: var(--fs-xs); color: var(--text-secondary); margin-bottom: var(--space-sm); display: flex; align-items: center; gap: var(--space-xs); }
.shipping-bar-text svg { width: 14px; height: 14px; flex-shrink: 0; }
.shipping-bar-text strong { color: var(--navy); font-weight: 700; }
.shipping-bar-track { height: 6px; background: var(--gray-200); border-radius: var(--radius-full); overflow: hidden; }
.shipping-bar-fill { height: 100%; border-radius: var(--radius-full); background: linear-gradient(90deg, var(--accent), #10b981); transition: width 0.6s var(--ease-out); }
.shipping-bar.complete { border-color: rgba(16,185,129,0.3); background: rgba(16,185,129,0.04); }
.shipping-bar.complete .shipping-bar-text { color: var(--success); }
.shipping-bar.complete .shipping-bar-fill { background: var(--success); }

/* --- Recommended Products --- */
.recommended-section { margin-top: var(--space-4xl); padding-top: var(--space-3xl); border-top: 1px solid var(--border-color); }
.recommended-section h2 { font-size: var(--fs-xl); margin-bottom: var(--space-xl); }
.recommended-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-lg); }
.rec-card { background: var(--white); border: 1px solid var(--border-color); border-radius: var(--radius-xl); overflow: hidden; transition: all 0.3s ease; }
.rec-card:hover { border-color: var(--accent); box-shadow: var(--shadow-lg); transform: translateY(-4px); }
.rec-card-img { background: var(--gray-50); padding: var(--space-lg); display: flex; align-items: center; justify-content: center; height: 160px; }
.rec-card-img img { max-width: 85%; max-height: 130px; object-fit: contain; }
.rec-card-body { padding: var(--space-md) var(--space-lg) var(--space-lg); }
.rec-card-cat { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); font-weight: 600; margin-bottom: 4px; }
.rec-card-name { font-family: var(--font-heading); font-size: var(--fs-sm); font-weight: 700; color: var(--navy); margin-bottom: 4px; line-height: 1.3; }
.rec-card-price { font-family: var(--font-heading); font-size: var(--fs-base); font-weight: 800; color: var(--navy); margin-bottom: var(--space-sm); }
.rec-card-btn { width: 100%; padding: 10px; font-size: var(--fs-xs); }
@media (max-width: 768px) { .recommended-grid { grid-template-columns: repeat(2, 1fr); } }

/* --- WhatsApp Float --- */
.whatsapp-float {
  position: fixed; bottom: var(--space-xl); left: var(--space-xl);
  z-index: var(--z-toast); width: 48px; height: 48px;
  background: #25D366; border-radius: var(--radius-full);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 15px rgba(37,211,102,0.3);
  transition: all var(--transition-fast);
}
.whatsapp-float:hover { transform: scale(1.08); box-shadow: 0 6px 20px rgba(37,211,102,0.4); }
.whatsapp-float svg { width: 24px; height: 24px; }

/* --- Toast --- */
.toast-container {
  position: fixed; top: calc(40px + var(--navbar-height) + var(--space-md)); right: var(--space-xl);
  z-index: var(--z-toast); display: flex; flex-direction: column; gap: var(--space-sm);
}
.toast {
  padding: 14px 20px; border-radius: var(--radius-md);
  background: var(--navy); color: var(--white); font-size: var(--fs-sm);
  box-shadow: var(--shadow-lg); max-width: 360px;
  animation: toastIn 0.3s var(--ease-out);
}
.toast.success { border-left: 3px solid var(--success); }
.toast.error { border-left: 3px solid var(--error); }
@keyframes toastIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

/* --- Scroll Progress --- */
.scroll-progress {
  position: fixed; top: 0; left: 0; height: 2px; z-index: var(--z-max);
  background: var(--accent); width: 0%;
  transition: width 50ms linear;
}

/* --- Preloader --- */
.preloader {
  position: fixed; inset: 0; z-index: 10000; background: var(--white);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  transition: opacity 0.5s ease, visibility 0.5s ease;
}
.preloader.hidden { opacity: 0; visibility: hidden; }
.preloader-logo { width: auto; height: 40px; margin-bottom: var(--space-xl); filter: brightness(0) !important; }
.preloader-bar { width: 120px; height: 2px; background: var(--gray-200); border-radius: var(--radius-full); overflow: hidden; }
.preloader-bar-fill { width: 0; height: 100%; background: var(--accent); border-radius: var(--radius-full); animation: preloaderFill 1.2s var(--ease-out) forwards; }
@keyframes preloaderFill { to { width: 100%; } }

/* --- Utility --- */
.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }

/* ─── HIDE FLOATING COOKIE RE-CONSENT WIDGET ─── */
.cookieadmin-btn,
.cookieadmin-reconsent-btn,
.cookieadmin_reconsent_img,
#cookieadmin-badge,
.cookieadmin-badge-container,
[class*="cookieadmin-reconsent"],
[id*="cookieadmin-reconsent"] {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
}



/* Mobile menu open fix */
.mobile-menu.open {
    display: flex !important;
}
