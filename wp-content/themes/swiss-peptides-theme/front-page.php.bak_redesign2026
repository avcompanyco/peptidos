    // Update total price when quantity selection changes
    function updateModalPrice() {
        const selectedOption = document.querySelector('.dose-option:checked');
        if (!selectedOption) return;
        const qty = parseInt(selectedOption.dataset.qty);
        const discount = parseInt(selectedOption.dataset.discount);
        
        let finalPrice = currentPrice * qty;
        if (discount > 0) {
            finalPrice = finalPrice * (1 - (discount / 100));
        }
        
        modalPriceVal.textContent = '$' + Math.round(finalPrice).toLocaleString('es-CO');
    }
    
    doseOptions.forEach(opt => {
        opt.addEventListener('change', updateModalPrice);
    });
    
    // Open Modal when clicking light peptide card
    cards.forEach(card => {
        card.addEventListener('click', function() {
            currentProductId = this.dataset.pid;
            currentTitle = this.dataset.title;
            const desc = this.dataset.desc;
            const img = this.dataset.image;
            const benefits = JSON.parse(this.dataset.benefits || '[]');
            const badge = this.dataset.badge;
            currentPrice = parseFloat(this.dataset.price);
            const priceHtml = this.dataset.priceHtml;
            const usage = this.dataset.usage;
            currentCheckoutUrl = this.dataset.checkout;
            
            // Populate
            modalTitle.textContent = currentTitle;
            modalSubtitle.textContent = badge;
            modalImage.src = img;
            modalImage.alt = currentTitle;
            modalDescription.textContent = desc;
            modalUsageText.textContent = usage;
            
            // Benefits list
            modalBenefits.innerHTML = '';
            benefits.forEach(b => {
                const li = document.createElement('li');
                li.textContent = b;
                modalBenefits.appendChild(li);
            });
            
            // Set prices in dose labels
            document.getElementById('dose-1-price').textContent = '$' + currentPrice.toLocaleString('es-CO');
            document.getElementById('dose-2-price').textContent = '$' + Math.round(currentPrice * 2 * 0.9).toLocaleString('es-CO');
            document.getElementById('dose-3-price').textContent = '$' + Math.round(currentPrice * 3 * 0.8).toLocaleString('es-CO');
            
            // Reset quantity selection to 1
            document.getElementById('dose-1').checked = true;
            updateModalPrice();
            
            // Reset active tab to benefits
            tabBtns.forEach(b => b.classList.remove('is-active'));
            tabContents.forEach(c => c.classList.remove('is-active'));
            document.querySelector('.modal-tab-btn[data-tab="benefits"]').classList.add('is-active');
            document.getElementById('tab-benefits').classList.add('is-active');
            
            // Set WhatsApp link
            const waText = encodeURIComponent(`Hola, me interesa recibir asesoría y comprar el producto: ${currentTitle}`);
            modalWhatsappBtn.href = `https://wa.me/573189163091?text=${waText}`;
            
            // Show modal
            modal.classList.add('is-active');
        });
    });
    
    // Close Modal
    function closeModal() {
        modal.classList.remove('is-active');
    }
    
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (overlay) overlay.addEventListener('click', closeModal);
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.classList.contains('is-active')) closeModal();
    });
    
    // Add to cart from modal
    if (modalBuyBtn) {
        modalBuyBtn.addEventListener('click', function() {
            const selectedOption = document.querySelector('.dose-option:checked');
            if (!selectedOption) return;
            const qty = parseInt(selectedOption.dataset.qty);
            
            // Show loading state
            modalBuyBtn.disabled = true;
            const originalText = modalBuyBtn.textContent;
            modalBuyBtn.textContent = 'Agregando...';
            
            // Execute AJAX Add to Cart
            jQuery.ajax({
                type: 'POST',
                url: wc_add_to_cart_params.ajax_url,
                data: {
                    action: 'woocommerce_add_to_cart',
                    product_id: currentProductId,
                    quantity: qty
                },
                success: function(response) {
                    jQuery(document.body).trigger('added_to_cart', [response.fragments, response.cart_hash, jQuery(modalBuyBtn)]);
                    modalBuyBtn.disabled = false;
                    modalBuyBtn.textContent = originalText;
                    closeModal();
                    
                    // Open mini cart drawer
                    const cartDrawer = document.getElementById('sp-cart-drawer');
                    if (cartDrawer) {
                        cartDrawer.classList.add('is-active');
                    }
                },
                error: function() {
                    modalBuyBtn.disabled = false;
                    modalBuyBtn.textContent = originalText;
                    window.location.href = currentCheckoutUrl + '&quantity=' + qty;
                }
            });
        });
    }
});
</script>

<?php get_footer(); ?>
